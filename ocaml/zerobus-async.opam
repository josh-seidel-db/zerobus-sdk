# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native OCaml Zerobus Ingest SDK — Async runtime"
description: """
Async instantiation of zerobus-core. Drives the runtime-agnostic h2 core over
an Async Reader/Writer duplex directly (no gluten-async/h2-async). Live TLS is
a dune select on the optional tls-async dep; without it, cleartext h2c works
and live TLS returns an honest error (see doc/arch/tls_async_status.md)."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "core"
  "async"
  "ppx_let"
  "h2"
  "bigstringaf"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
depopts: ["tls-async" "ca-certs" "domain-name" "tls"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
