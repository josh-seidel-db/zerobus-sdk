# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Native OCaml Zerobus Ingest SDK — stateless REST insert helper (Async)"
description: """
The Async instantiation of the optional REST interface (DESIGN §4.2): the
counterpart of zerobus-rest (Lwt). A thin POST-per-batch JSON insert wrapper
reusing zerobus-core's scoped OAuth grant and the shared pure-ocaml-tls HTTP
backend from zerobus-async (over Tls_async.connect — no cohttp-async/OpenSSL).
For high volume use the zerobus-async (gRPC streaming) package instead."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "zerobus-async" {= version}
  "core"
  "async"
  "ppx_let"
  "yojson"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
