; zerobus-async: Async instantiation of zerobus-core's IO functor.
;
; The transport drives the runtime-agnostic h2 core (H2.Client_connection) over an
; Async Reader/Writer duplex ourselves (see h2_pump.ml) — NOT gluten-async/h2-async,
; whose TLS backend is a build-time dummy on our switches. TLS connect is a dune
; [select] on tls-async: real (tls_connect.real.ml) when it is installed, else an
; honest-error stub (tls_connect.dummy.ml). So this builds on a switch WITHOUT
; tls-async (cleartext h2c mocks work; live TLS returns an error) and gains live
; TLS wherever tls-async is present. See doc/arch/tls_async_status.md.
(library
 (name zerobus_async)
 (public_name zerobus-async)
 (preprocess
  (pps ppx_let))
 (libraries
  zerobus-core
  core
  core_unix
  async
  h2
  bigstringaf
  (select
   tls_connect.ml
   from
   (tls-async ca-certs domain-name tls x509 ptime.clock.os ->
    tls_connect.real.ml)
   (-> tls_connect.dummy.ml))
  ; Built-in client-credentials OAuth HTTP backend: a [select] on the SAME
  ; pure-OCaml TLS stack the gRPC transport uses (tls-async + ca-certs + domain-name
  ; + tls) plus yojson/base64 for the token JSON. The token POST is hand-rolled
  ; HTTP/1.1 over Tls_async.connect (NOT cohttp-async, whose conduit-async only does
  ; TLS via async_ssl/OpenSSL — the C dep the SDK avoids, DESIGN §12.5). So built-in
  ; OAuth lights up wherever live TLS does; when tls-async is absent the dummy
  ; backend returns an honest error and the caller supplies a bearer via
  ; with_stream's headers_provider.
  (select
   oauth.ml
   from
   (tls-async ca-certs domain-name tls yojson base64 -> oauth.real.ml)
   (-> oauth.dummy.ml))))
