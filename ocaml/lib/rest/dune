; zerobus-rest (§4.2): the optional, stateless REST insert helper. A thin
; POST-per-batch wrapper reusing zerobus-core's OAuth body-builder + cohttp-lwt.
; No streams/offsets/recovery — kept a separate package so gRPC users don't pull
; it and REST-only users don't pull the h2/tls streaming stack.
(library
 (name zerobus_rest)
 (public_name zerobus-rest)
 (libraries
  zerobus-core
  cohttp-lwt-unix
  lwt
  lwt.unix
  yojson
  uri
  base64))
