opam-version: "2.0"
synopsis: "Runtime-agnostic core of the native OCaml Zerobus Ingest SDK"
description: """
Speaks the Zerobus gRPC ingest protocol directly (no FFI). Runtime-agnostic:
the IO functor is instantiated by the zerobus (Lwt), zerobus-eio (Eio), and
zerobus-async (Async) packages. Not useful on its own — pick a runtime package."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "pbrt" {>= "3.0"}
  "ocaml-protoc" {>= "4.1" & build}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
