# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Native OCaml Zerobus Ingest SDK — stateless REST insert helper (Eio)"
description: """
The Eio (direct-style) instantiation of the optional REST interface
(DESIGN §4.2): the counterpart of zerobus-rest (Lwt). A thin POST-per-batch
JSON insert wrapper over cohttp-eio, reusing zerobus-core's scoped OAuth
grant. Requires OCaml >= 5.0. For high volume use the zerobus-eio (gRPC
streaming) package instead."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "5.0"}
  "zerobus-core" {= version}
  "cohttp-eio"
  "eio"
  "eio_main"
  "tls"
  "tls-eio"
  "mirage-crypto-rng"
  "x509"
  "ca-certs"
  "domain-name"
  "http"
  "yojson"
  "uri"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
