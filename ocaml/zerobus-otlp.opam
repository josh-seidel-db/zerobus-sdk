# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native OCaml Zerobus Ingest SDK — OTLP (OpenTelemetry) exporter"
description: """
The optional OTLP interface (DESIGN §4.3): an otlp/grpc LogsService /
MetricsService exporter that ships OpenTelemetry logs and metrics to the
Zerobus OTLP endpoint over the same TLS 1.3 + ALPN h2 transport the gRPC SDK
uses. Vendors the OpenTelemetry collector protos independently of the Zerobus
wire schema."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "zerobus" {= version}
  "pbrt" {>= "3.0"}
  "ocaml-protoc" {>= "4.1" & build}
  "lwt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
