; Async built-in OAuth test: drives Zerobus_async.mint_token's client-credentials
; flow against a local cohttp-async mock token endpoint. The Async counterpart of
; test_driver_eio/test_oauth_eio.
;
; (optional) so the dir VANISHES on switches WITHOUT cohttp-async (e.g. the canonical
; fl414, which keeps cohttp 6.0) instead of erroring — built-in OAuth is a dune
; [select] on cohttp-async (see lib/async/dune, doc/arch/tls_async_status.md). It
; lights up on a cohttp-async-equipped switch. NOT in CI's fl414 job (which targets
; specific dirs and never names this one), same pattern as test_driver_async_tls/.
(executable
 (name test_oauth_async)
 (modules test_oauth_async)
 (optional)
 (preprocess
  (pps ppx_let))
 (libraries zerobus-async zerobus-core core async unix cohttp-async alcotest))

(rule
 (alias runtest)
 (deps test_oauth_async.exe)
 (action
  (run ./test_oauth_async.exe)))
