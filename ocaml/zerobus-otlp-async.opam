  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "zerobus-async" {= version}
  "pbrt" {>= "3.0"}
  "ocaml-protoc" {>= "4.1" & build}
  "core"
  "async"
  "ppx_let"
  "yojson"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
