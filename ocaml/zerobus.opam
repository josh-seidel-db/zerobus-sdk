opam-version: "2.0"
synopsis: "Native OCaml Zerobus Ingest SDK — Lwt runtime"
description: """
Lwt instantiation of zerobus-core. Streams records into Databricks tables
over gRPC with the loop-then-flush ingestion pattern."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "lwt"
  "lwt_ppx"
  "grpc-lwt"
  "h2-lwt-unix"
  "tls-lwt"
  "ca-certs"
  "cohttp-lwt-unix"
  "yojson"
  "uri"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
