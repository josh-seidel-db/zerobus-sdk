# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native OCaml Zerobus Ingest SDK — stateless REST insert helper"
description: """
The optional REST interface (DESIGN §4.2): a thin POST-per-batch JSON insert
wrapper for low-frequency / edge cases. Reuses zerobus-core's scoped OAuth
grant. No streams, offsets, or recovery — for high volume use the zerobus
(gRPC streaming) package instead."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "zerobus-core" {= version}
  "cohttp-lwt-unix"
  "lwt"
  "yojson"
  "uri"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
