  "eio_main"
  "grpc-eio"
  "h2-eio"
  "tls"
  "tls-eio"
  "mirage-crypto-rng"
  "x509"
  "ca-certs"
  "domain-name"
  "cohttp-eio"
  "http"
  "yojson"
  "uri"
  "base64"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
