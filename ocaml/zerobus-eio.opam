opam-version: "2.0"
synopsis: "Native OCaml Zerobus Ingest SDK — Eio runtime"
description:
  "Eio (direct-style) instantiation of zerobus-core. Requires OCaml >= 5.0."
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "5.0"}
  "zerobus-core" {= version}
