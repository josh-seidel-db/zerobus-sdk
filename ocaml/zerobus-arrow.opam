opam-version: "2.0"
synopsis:
  "Native OCaml Zerobus Ingest SDK — optional Apache Arrow IPC codec"
description: """
The optional Arrow IPC codec for record_type=Arrow (DESIGN §8.5.2). The only
component that links Apache Arrow (C++), kept a separate package so JSON/Proto
users never pull libarrow. Requires apache-arrow (system, via pkg-config)."""
maintainer: ["Databricks"]
authors: ["Databricks"]
license: "Apache-2.0"
homepage: "https://github.com/databricks/zerobus-sdk"
bug-reports: "https://github.com/databricks/zerobus-sdk/issues"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "conf-pkg-config" {build}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/databricks/zerobus-sdk.git"
